{
  "name": "todo-app",
  "version": "1.0.0",
  "description": "A simple to-do list app wrapped as an Android APK with Capacitor",
  "scripts": {
    "sync": "npx cap sync android",
    "open:android": "npx cap open android",
    "build:apk": "cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
